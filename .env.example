# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key

# Optional: use a different Gemini model than the default
# GEMINI_MODEL=gemini-3.5-flash-lite

# Only needed for the optional FastAPI + Supabase backend (backend/)
# READONLY_DATABASE_URL=postgresql://readonly_user:password@host:5432/postgres?sslmode=require
